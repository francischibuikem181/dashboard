<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.8/css/bootstrap-grid.min.css"
        integrity="sha512-dOjUSaLkr6G2pwQ7ry9juX+iXw5602zg1kg8yH+guR3uSEidGyCnOEQnGlr7xwu/8WE+pVm1ZNqaIs5ETTIJQg=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />

    <style>
        * {
            margin: 0; 
            padding: 0; 
            box-sizing: border-box;
            /* background-color: aqua; */
        }

        body {
            padding: 10px;
            height: 100vh;
            background-color: rgb(153, 223, 223);
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
        }

        .color1 {
            background-color: rgb(36, 36, 87);
            width: 15%;
            height: 100%;
            /* border: 1px solid red; */
            border-radius: 10px;
            display: flex;
            flex-direction: column;
        }

        .color2 {
            background-color: rgb(153, 223, 223);
            /* background-color: rgb(238, 234, 233); */
            width: 85%;
            height: 100%;
            border-radius: 10px;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            padding: 5px;
            gap: 5px;
        }

        .flex-cont {
            display: flex;
        }


        .div-1 {
            /* border: 1px solid black; */
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
        }

        .subMain2 {
            height: 80%;
            width: 100%;
            border-radius: 10px;
            /* border: 1px solid red; */
            background-color: white;

        }

        .subMain1 {
            height: 20%;
            width: 100%;
            border-radius: 10px;
            /* border: 1px solid rgb(0, 0, 0); */
            background-color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .headDiv1 {
            height: 50%;
            width: 300px;
            /* border: 1px solid red; */
            display: flex;
            align-items: center;
            justify-content: center;

            input {
                border: none;
                width: 80%;
                height: 65%;
                border-radius: 10px;
                padding: 9px;
                background-color: rgb(244, 236, 236);

            }



        }

        .headDiv2 {
            height: 50%;
            width: 300px;
            /* border: 1px solid red; */
            display: flex;
            justify-content: space-evenly;
            gap: 5px;
            align-items: center;


            div {
                height: 60%;
                /* border: 1px solid black; */
                width: 20%;
                display: flex;
                justify-content: center;
                align-items: center;

                svg {
                    height: 30px;
                    width: 30px;
                    color: rgb(39, 33, 33);
                }
            }
        }

        aside {

            display: flex;
            flex-direction: column;
            gap: 10px;


            div {
                display: flex;
                gap: 15px;
                align-items: center;
                padding-inline: 10px;
                font-weight: 600;
                color: white;
                /* border: 1px solid black; */
                padding-block: 5px;

                svg {
                    height: 30px;
                    width: 30px;
                }
            }
        }
    </style>
</head>

